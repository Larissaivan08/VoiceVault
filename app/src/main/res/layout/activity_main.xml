<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cabeçalho -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/header_title"
        android:textAppearance="?textAppearanceHeadlineSmall"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/header_subtitle"
        android:textAppearance="?textAppearanceBodyMedium"
        android:textColor="?android:textColorSecondary" />

    <!-- ===== Painel de gravação (card) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Indicador "gravando em" (persistente e claro) -->
            <TextView
                android:id="@+id/recordInFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceLabelLarge"
                android:textColor="?colorPrimary" />

            <!-- Status + formato compacto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <View
                    android:id="@+id/recDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_rec"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/statusLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?textAppearanceBodyMedium"
                    android:textColor="#FE5752" />

                <Button
                    android:id="@+id/btnFormat"
                    style="?materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:paddingVertical="6dp"
                    android:textSize="12sp"
                    android:contentDescription="@string/desc_format" />
            </LinearLayout>

            <!-- Cronômetro grande (foco principal) -->
            <TextView
                android:id="@+id/timerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="00:00:00"
                android:textSize="42sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/desc_timer" />

            <!-- Forma de onda -->
            <com.example.voicevault.io.WaveView
                android:id="@+id/wave"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp" />

            <!-- Controles principais -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnPauseResume"
                    style="?materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="⏸ Pausar"
                    android:contentDescription="@string/desc_pause" />

                <Button
                    android:id="@+id/btnRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:backgroundTint="#FE5752"
                    android:textColor="#FFFFFF"
                    android:text="@string/btn_record"
                    android:contentDescription="@string/desc_record" />

                <Button
                    android:id="@+id/btnMarker"
                    style="?materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="＋ Marcador"
                    android:contentDescription="@string/desc_marker" />
            </LinearLayout>

            <!-- Configurações discretas (peso visual reduzido) -->
            <LinearLayout
                android:id="@+id/btnQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:focusable="true"
                android:contentDescription="@string/desc_quality">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎚 Qualidade:"
                    android:textAppearance="?textAppearanceBodySmall"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:id="@+id/qualityValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textAppearance="?textAppearanceBodySmall"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== Área de pastas: grade 2 colunas, independente da lista de gravações ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/title_folders"
            android:textAppearance="?textAppearanceTitleMedium" />

        <Button
            android:id="@+id/btnAddFolder"
            style="?materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:textSize="12sp"
            android:text="@string/btn_new_folder"
            android:contentDescription="@string/desc_new_folder" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/folderGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="220dp"
        android:nestedScrollingEnabled="false"
        android:layout_marginTop="4dp" />

    <!-- ===== Minhas gravações ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/title_recordings"
            android:textAppearance="?textAppearanceTitleMedium" />

        <Button
            android:id="@+id/btnSort"
            style="?materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:textSize="12sp"
            android:text="Ordenar: data ↓"
            android:contentDescription="@string/desc_sort" />
    </LinearLayout>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_search"
        android:inputType="text"
        android:maxLines="1"
        android:autofillHints=""
        android:layout_marginTop="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:text="@string/empty_hint"
        android:textAppearance="?textAppearanceBodyLarge"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone" />
</LinearLayout>
