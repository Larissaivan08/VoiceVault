<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="?attr/colorSurface">

        <!-- Cabeçalho -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VoiceVault"
            android:textAppearance="?textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gravador de áudio"
            android:textAppearance="?textAppearanceBodyMedium"
            android:textColor="?android:textColorSecondary" />

        <!-- Painel principal de gravação (card branco) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <View
                        android:id="@+id/recDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_rec"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/statusLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:textColor="#FE5752" />

                    <Button
                        android:id="@+id/btnFormat"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:text="M4A" />
                </LinearLayout>

                <!-- Cronômetro grande -->
                <TextView
                    android:id="@+id/timerLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="00:00:00"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Forma de onda -->
                <com.example.voicevault.io.WaveView
                    android:id="@+id/wave"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnRecord"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/record_coral"
                    android:text="🎙"
                    android:textSize="46sp"
                    android:contentDescription="Iniciar ou parar gravação"
                    app:cornerRadius="80dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">
                    <Button
                        android:id="@+id/btnPauseResume"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="⏸  Pausar"
                        android:minHeight="54dp"
                        app:cornerRadius="20dp"
                        android:enabled="false"/>
                    <Button
                        android:id="@+id/btnMarker"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="♧  Marcar"
                        android:minHeight="54dp"
                        app:cornerRadius="20dp"
                        android:enabled="false"/>
                    <Button
                        android:id="@+id/btnTheme"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="☼ Tema"
                        android:minHeight="54dp"
                        app:cornerRadius="20dp"/>
                </LinearLayout>

                <!-- Qualidade -->
                <TextView
                    android:id="@+id/btnQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingVertical="10dp"
                    android:background="?selectableItemBackground"
                    android:text="🎚 Qualidade de gravação  ›"
                    android:textAppearance="?textAppearanceBodyLarge" />

                <TextView
                    android:id="@+id/qualityValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alta qualidade (AAC 128 kbps)"
                    android:textAppearance="?textAppearanceBodySmall"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginTop="20dp">
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="Pastas"
                android:textAppearance="?textAppearanceTitleLarge" android:textStyle="bold"/>
            <Button android:id="@+id/btnAddFolder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+ Nova pasta"/>
        </LinearLayout>
        <GridLayout android:id="@+id/folderGrid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="2" android:alignmentMode="alignMargins"
            android:useDefaultMargins="false"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/folderChips" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Arquivos da pasta" android:textStyle="bold"
            android:textAppearance="?textAppearanceTitleMedium"
            android:layout_marginTop="18dp"/>
        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_search"
            android:inputType="text"
            android:maxLines="1"
            android:autofillHints=""
            android:layout_marginTop="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="24dp"
            android:text="@string/empty_hint"
            android:textAppearance="?textAppearanceBodyLarge"
            android:textColor="?android:textColorSecondary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
